{
	"name": "stdf-vscode-extension",
	"displayName": "Any TDF for VS Code",
	"version": "1.0.0",
	"private": true,
	"description": "Hover documentation and code completion for STDF, RTDF, and VTDF components.",
	"categories": [
		"Extension Packs",
		"Programming Languages"
	],
	"keywords": [
		"any-tdf",
		"api",
		"component",
		"react",
		"rtdf",
		"stdf",
		"svelte",
		"vtdf",
		"vue"
	],
	"homepage": "https://github.com/any-tdf/any-tdf/tree/main/extensions/vscode-extension#readme",
	"bugs": {
		"url": "https://github.com/any-tdf/any-tdf/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "extensions/vscode-extension"
	},
	"sponsor": {
		"url": "https://any-tdf.dev?fund"
	},
	"publisher": "STDF",
	"main": "./src/extension.js",
	"scripts": {
		"files": "bun scripts/files.js",
		"files:check": "bun scripts/files.js --check",
		"marketplace:check": "bun scripts/marketplace-version.js",
		"test": "bun test",
		"package": "bun run ../../scripts/run-with-root-license.mjs bun run vsce package --no-dependencies && bun run verify:package",
		"verify:package": "bun scripts/verify-package.js",
		"publish": "bun run ../../scripts/run-with-root-license.mjs bun run vsce publish --no-dependencies --skip-duplicate"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/vscode": "1.80.0",
		"@vscode/vsce": "^3.9.2"
	},
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Any TDF",
			"properties": {
				"AnyTDF.English": {
					"type": "boolean",
					"default": false,
					"description": "Show bundled component API documentation in English instead of Simplified Chinese."
				},
				"STDF.English": {
					"type": "boolean",
					"default": false,
					"description": "Legacy language setting retained for existing STDF for VS Code users.",
					"deprecationMessage": "Use AnyTDF.English instead."
				}
			}
		}
	},
	"activationEvents": [
		"onLanguage:javascriptreact",
		"onLanguage:svelte",
		"onLanguage:typescriptreact",
		"onLanguage:vue"
	],
	"extensionPack": [
		"Vue.volar",
		"svelte.svelte-vscode"
	],
	"extensionKind": [
		"workspace"
	],
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#111827",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": {
			"supported": false,
			"description": "Any TDF for VS Code reads the nearest package.json from the local or remote workspace file system."
		}
	},
	"pricing": "Free"
}
