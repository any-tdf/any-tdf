{
	"name": "vrut",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json && vp build",
		"preview": "vp preview",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint",
		"check": "vp lint && vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json",
		"typecheck:native": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
	},
	"dependencies": {
		"vtdf": "0.0.0",
		"vue": "^3.5.39"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@unocss/preset-wind4": "^66.7.5",
		"@vitejs/plugin-vue": "^6.0.7",
		"typescript": "npm:typescript-native-bridge@6.0.3-bridge.7.tsgo.7.0.2",
		"unocss": "^66.7.5",
		"vite": "^8.1.3",
		"vite-plus": "^0.2.4",
		"vue-tsc": "^3.3.8"
	}
}
