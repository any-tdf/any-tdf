{
	"name": "site",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"env": "bun run scripts/env.js",
		"dev": "bun run env && vite dev",
		"preview": "vite preview",
		"build": "bun run env && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@any-tdf/vite-plugin-md-ts": "^0.0.2",
		"@any-tdf/vite-plugin-svg-symbol": "^0.0.3",
		"@eslint/compat": "^2.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"beautify-qrcode": "^1.0.3",
		"clipboard": "^2.0.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"highlight.js": "^11.11.1",
		"highlightjs-svelte": "^1.0.6",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"stdf": "file:../../packages/stdf",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-confetti": "^2.3.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
