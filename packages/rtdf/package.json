{
	"name": "rtdf",
	"version": "0.0.1-alpha.3",
	"description": "Mobile web React component library based on Tailwind CSS and the any-tdf design system.",
	"keywords": [
		"component library",
		"mobile ui",
		"react",
		"tailwind",
		"ui framework",
		"ui 组件库",
		"web component",
		"移动组件库"
	],
	"homepage": "https://rtdf.dev",
	"license": "MIT",
	"author": "any-tdf",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/rtdf"
	},
	"funding": "https://any-tdf.dev/?fund",
	"style": "./dist/style.css",
	"files": [
		"dist",
		"source.css",
		"README.md",
		"LICENSE",
		"!dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./style.css": {
			"default": "./dist/style.css"
		},
		"./source.css": {
			"default": "./source.css"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js",
			"default": "./dist/components/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"import": "./dist/theme/index.js",
			"default": "./dist/theme/index.js"
		},
		"./theme/plugin": {
			"types": "./dist/theme/plugin.d.ts",
			"import": "./dist/theme/plugin.js",
			"default": "./dist/theme/plugin.js"
		},
		"./theme/runtime": {
			"types": "./dist/theme/runtime.d.ts",
			"import": "./dist/theme/runtime.js",
			"default": "./dist/theme/runtime.js"
		},
		"./svg": {
			"types": "./dist/svg/index.d.ts",
			"import": "./dist/svg/index.js",
			"default": "./dist/svg/index.js"
		},
		"./lang": {
			"types": "./dist/lang/index.d.ts",
			"import": "./dist/lang/index.js",
			"default": "./dist/lang/index.js"
		},
		"./utils": {
			"types": "./dist/components/utils/index.d.ts",
			"import": "./dist/components/utils/index.js",
			"default": "./dist/components/utils/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "vp build --config vite.lib.config.ts && cp src/index.css dist/style.css && tsc -p tsconfig.lib.json && bun run ../../scripts/minify-package-js.mjs dist",
		"package": "bun run build && publint && bun pm pack --dry-run --quiet",
		"test": "bun test scripts/release.test.ts",
		"release:check": "bun run test && bun run check && bun run package",
		"prepack": "bun run ../../scripts/package-license.mjs stage",
		"postpack": "bun run ../../scripts/package-license.mjs clean",
		"prepublishOnly": "bun run release:check",
		"verify:workspace": "bun run test",
		"check": "tsc -p tsconfig.lib.json --noEmit",
		"typecheck:native": "tsc -p tsconfig.lib.json --noEmit"
	},
	"dependencies": {
		"@any-tdf/common": "workspace:^",
		"@any-tdf/react-motion": "workspace:^"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"@vitejs/plugin-react": "catalog:react",
		"publint": "catalog:",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"tailwindcss": "catalog:",
		"typescript": "catalog:typescript7",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:peer",
		"react-dom": "catalog:peer",
		"tailwindcss": "catalog:peer"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	}
}
