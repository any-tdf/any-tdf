{
	"compilerOptions": {
		"types": ["node", "bun"],
		"target": "ES2020",
		"lib": ["ES2020"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true
	},
	"include": ["src/index.ts"],
	"exclude": ["dist", "node_modules"]
}
