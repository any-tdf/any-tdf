{
	"name": "vrut",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vp build",
		"preview": "vp preview",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint",
		"check": "vp lint && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
		"typecheck:native": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"rtdf": "0.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@unocss/preset-wind4": "^66.7.5",
		"@vitejs/plugin-react": "^6.0.3",
		"typescript": "^7.0.2",
		"unocss": "^66.7.5",
		"vite": "^8.1.3",
		"vite-plus": "^0.2.4"
	}
}
