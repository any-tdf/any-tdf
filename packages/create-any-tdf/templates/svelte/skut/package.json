{
	"name": "skut",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync",
		"check": "vp lint && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt",
		"lint": "vp lint",
		"format:check": "vp fmt --check",
		"typecheck:native": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"@unocss/preset-wind4": "^66.7.5",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.4",
		"typescript": "6.0.3",
		"unocss": "^66.7.5",
		"vite": "^8.1.3",
		"vite-plus": "^0.2.4"
	}
}
