{
	"name": "create-any-tdf",
	"version": "0.0.1-alpha.0",
	"description": "A CLI for creating STDF, RTDF, and VTDF TypeScript projects",
	"keywords": [
		"any-tdf",
		"cli",
		"react",
		"rtdf",
		"stdf",
		"svelte",
		"tailwind",
		"typescript",
		"unocss",
		"vite",
		"vtdf",
		"vue"
	],
	"homepage": "https://github.com/any-tdf/any-tdf/blob/main/packages/create-any-tdf/README.md",
	"bugs": {
		"url": "https://github.com/any-tdf/any-tdf/issues"
	},
	"license": "MIT",
	"author": "any-tdf",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/create-any-tdf"
	},
	"bin": {
		"create-any-tdf": "dist/index.js"
	},
	"files": [
		"dist/**",
		"templates/**",
		"snippet/**",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"type": "module",
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "rollup -c",
		"bt": "rollup -c && bun run dist/index.js",
		"test": "bun run build",
		"package": "bun run build && publint && bun pm pack --dry-run --quiet",
		"release:check": "bun run test && bun run verify:templates && bun run package",
		"prepack": "bun run ../../scripts/package-license.mjs stage",
		"postpack": "bun run ../../scripts/package-license.mjs clean",
		"prepublishOnly": "bun run release:check",
		"verify:templates": "bun run scripts/verify-templates.mjs"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"fs-extra": "^11.3.6",
		"kleur": "^4.1.5",
		"minimist": "^1.2.8",
		"oxfmt": "^0.57.0",
		"pacote": "^22.0.0"
	},
	"devDependencies": {
		"@rollup/plugin-terser": "^1.0.0",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"publint": "catalog:",
		"rollup": "^4.62.2"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
