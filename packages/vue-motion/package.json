{
	"name": "@any-tdf/vue-motion",
	"version": "0.0.0-alpha.1",
	"description": "Vue motion utilities compatible with Svelte transition, animate, easing, and motion APIs.",
	"keywords": [
		"animation",
		"motion",
		"transition",
		"vue",
		"vue3"
	],
	"homepage": "https://github.com/any-tdf/any-tdf/tree/main/packages/vue-motion#readme",
	"bugs": {
		"url": "https://github.com/any-tdf/any-tdf/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/vue-motion"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"!dist/**/*.map"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./easing": {
			"types": "./dist/easing.d.ts",
			"import": "./dist/easing.js",
			"default": "./dist/easing.js"
		},
		"./transition": {
			"types": "./dist/transition.d.ts",
			"import": "./dist/transition.js",
			"default": "./dist/transition.js"
		},
		"./animate": {
			"types": "./dist/animate.d.ts",
			"import": "./dist/animate.js",
			"default": "./dist/animate.js"
		},
		"./motion": {
			"types": "./dist/motion.d.ts",
			"import": "./dist/motion.js",
			"default": "./dist/motion.js"
		},
		"./vue": {
			"types": "./dist/vue.d.ts",
			"import": "./dist/vue.js",
			"default": "./dist/vue.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json && bun run ../../scripts/minify-package-js.mjs dist",
		"test": "bun test",
		"package": "bun run build && publint && bun pm pack --dry-run --quiet",
		"release:check": "bun run check && bun run test && bun run package",
		"prepack": "bun run ../../scripts/package-license.mjs stage",
		"postpack": "bun run ../../scripts/package-license.mjs clean",
		"prepublishOnly": "bun run release:check",
		"check": "vue-tsc -b",
		"typecheck:native": "vue-tsc -b"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"publint": "catalog:",
		"typescript": "catalog:vue-native",
		"vue": "catalog:vue",
		"vue-tsc": "catalog:vue"
	},
	"peerDependencies": {
		"vue": "catalog:peer"
	}
}
