{
	"name": "@any-tdf/react-confetti",
	"version": "0.0.0-alpha.1",
	"description": "React port of svelte-confetti's pure HTML and CSS confetti effect.",
	"keywords": [
		"confetti",
		"css animation",
		"react",
		"ssr",
		"svelte-confetti"
	],
	"homepage": "https://github.com/any-tdf/any-tdf/tree/main/packages/react-confetti#readme",
	"bugs": {
		"url": "https://github.com/any-tdf/any-tdf/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/react-confetti"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"!dist/**/*.map"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json && bun run ../../scripts/minify-package-js.mjs dist",
		"test": "bun test",
		"package": "bun run build && publint && bun pm pack --dry-run --quiet",
		"release:check": "bun run check && bun run test && bun run package",
		"prepack": "bun run ../../scripts/package-license.mjs stage",
		"postpack": "bun run ../../scripts/package-license.mjs clean",
		"prepublishOnly": "bun run release:check",
		"check": "tsc -p tsconfig.json",
		"typecheck:native": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"publint": "catalog:",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:typescript7"
	},
	"peerDependencies": {
		"react": "catalog:peer",
		"react-dom": "catalog:peer"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
