{
	"name": "vtdf-skill",
	"version": "0.0.1",
	"private": true,
	"description": "AI Skill package for building with VTDF, Vue 3, and Tailwind CSS 4.",
	"keywords": [
		"ai",
		"codex",
		"skill",
		"tailwindcss",
		"vtdf",
		"vue"
	],
	"homepage": "https://vtdf.dev",
	"license": "MIT",
	"author": "any-tdf",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/skills/vtdf-skill"
	},
	"files": [
		"vtdf",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"generate": "bun run generate:components && bun run generate:themes",
		"generate:check": "bun ../../../scripts/generate-skill-component-references.mjs --target vtdf --check && bun ../../../scripts/generate-skill-theme-data.mjs --target vtdf --check",
		"generate:components": "bun ../../../scripts/generate-skill-component-references.mjs --target vtdf",
		"generate:themes": "bun ../../../scripts/generate-skill-theme-data.mjs --target vtdf",
		"validate": "bun ../../../scripts/validate-ai-skill.mjs --target vtdf",
		"test:theme": "bun scripts/test-theme.mjs",
		"test": "bun run generate:check && bun run validate && bun run test:theme"
	},
	"devDependencies": {
		"@types/node": "catalog:"
	},
	"engines": {
		"node": ">=18.18"
	}
}
