{
	"name": "rtdf-skill",
	"version": "0.0.1",
	"private": true,
	"description": "AI Skill package for building with RTDF, React and Tailwind CSS 4.",
	"keywords": [
		"ai",
		"codex",
		"react",
		"rtdf",
		"skill",
		"tailwindcss"
	],
	"homepage": "https://rtdf.dev",
	"license": "MIT",
	"author": "any-tdf",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "packages/skills/rtdf-skill"
	},
	"files": [
		"rtdf",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"generate": "bun run generate:components && bun run generate:themes",
		"generate:check": "bun ../../../scripts/generate-skill-component-references.mjs --target rtdf --check && bun ../../../scripts/generate-skill-theme-data.mjs --target rtdf --check",
		"generate:components": "bun ../../../scripts/generate-skill-component-references.mjs --target rtdf",
		"generate:themes": "bun ../../../scripts/generate-skill-theme-data.mjs --target rtdf",
		"validate": "bun ../../../scripts/validate-ai-skill.mjs --target rtdf",
		"test:theme": "bun scripts/test-theme.mjs",
		"test": "bun run generate:check && bun run validate && bun run test:theme"
	},
	"devDependencies": {
		"@types/node": "catalog:"
	},
	"engines": {
		"node": ">=18.18"
	}
}
