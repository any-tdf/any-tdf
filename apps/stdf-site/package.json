{
	"name": "@any-tdf/stdf-site",
	"version": "0.0.1",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/any-tdf/any-tdf.git",
		"directory": "apps/stdf-site"
	},
	"type": "module",
	"scripts": {
		"env": "bun run scripts/env.js",
		"dev": "bun run env && vp dev",
		"preview": "vp preview",
		"build": "bun run env && vp build",
		"deploy:check": "bun run check && bun run build",
		"check": "bun run typecheck:native",
		"check:watch": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --watch",
		"verify:site": "bun run scripts/verify-site.ts",
		"verify:workspace": "bun run verify:site",
		"verify:browser": "bun run scripts/verify-browser.ts",
		"typecheck:native": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@any-tdf/common": "workspace:*",
		"@any-tdf/site-common": "workspace:*",
		"stdf": "workspace:*"
	},
	"devDependencies": {
		"@any-tdf/vite-plugin-md-ts": "workspace:*",
		"@any-tdf/vite-plugin-svg-symbol": "workspace:*",
		"@lucide/svelte": "^1.24.0",
		"@sveltejs/adapter-static": "catalog:svelte",
		"@sveltejs/kit": "catalog:svelte",
		"@sveltejs/vite-plugin-svelte": "catalog:svelte",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"beautify-qrcode": "catalog:",
		"clipboard": "catalog:",
		"highlight.js": "catalog:",
		"highlightjs-svelte": "^1.0.6",
		"svelte": "catalog:svelte",
		"svelte-check": "catalog:svelte",
		"svelte-confetti": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
